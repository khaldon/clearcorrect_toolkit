{
  "manifest_version": 3,
  "name": "ClearComm Toolkits",
  "version": "2.3.0",
  "description": "ClearCorrect helper: clinical note builder, STL download naming, portal reminders, and an activity log.",
  "permissions": [
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://*.clearcorrect.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://translate.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClearComm Toolkits",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.clearcorrect.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
